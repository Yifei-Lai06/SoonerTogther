# Copy this file to .env.local and fill in your own values. NEVER commit .env.local
# and never paste these values into a chat. See SETUP_GUIDE.md for where to find each one.

# ── Supabase (cloud mode). Without these the app runs as a local demo. ─────────
# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (safe in the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase → Project Settings → API Keys → Secret key (SERVER ONLY — bypasses security rules)
SUPABASE_SECRET_KEY=
# Laptop only, for `npm run db:migrate`: Supabase → Connect → Session pooler connection string
# (with your database password filled in). Do NOT add this one to Vercel.
SUPABASE_DB_URL=

# ── AI assistant (optional) ──────────────────────────────────────────────────
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# AI_DAILY_LIMIT_PER_USER=30
# AI_DAILY_LIMIT_TOTAL=500

# ── Optional ────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to open /admin/feedback
ADMIN_EMAILS=
# OU email verification codes (https://resend.com). Leave empty to disable.
RESEND_API_KEY=
# RESEND_FROM=SoonerTogether <verify@yourdomain.com>
